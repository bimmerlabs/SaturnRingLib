{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SRL: Build Unit Tests (Emulator)",
            "type": "shell",
            "command": "./compile.bat clean && ./compile.bat debug ../Compiler SRL_LOG_OUTPUT=EMULATOR",
            "windows": {
                "command": "./compile.bat clean; ./compile.bat debug ../Compiler SRL_LOG_OUTPUT=EMULATOR"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "SRL: Build Unit Tests (Devcart)",
            "type": "shell",
            "command": "./compile.bat clean && ./compile.bat debug ../Compiler SRL_LOG_OUTPUT=DEV_CART",
            "windows": {
                "command": "./compile.bat clean; ./compile.bat debug ../Compiler SRL_LOG_OUTPUT=DEV_CART"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "SRL: Run Tests (mednafen)",
            "type": "shell",
            "command": "./run_tests.bat",
            "windows": {
                "command": "./run_tests.bat"
            },
            "args": [
                "mednafen"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "SRL: Run Tests (USBGamers)",
            "type": "shell",
            "command": "./run_tests.bat",
            "windows": {
                "command": "./run_tests.bat"
            },
            "args": [
                "USBGamers"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "SRL: Run Tests (kronos)",
            "type": "shell",
            "command": "./run_tests.bat",
            "windows": {
                "command": "./run_tests.bat"
            },
            "args": [
                "kronos"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}